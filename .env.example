# === SCANGO ENV CONFIGURATION ===
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env berisi secret ke repository!

# Port server backend (lokal)
PORT=3000

# Secret untuk sign JWT. Gunakan nilai acak yang panjang.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Project ref Supabase (untuk migrate.js)
PROJECT_REF=xxxx

# Password database Supabase (untuk migrate.js / koneksi langsung)
DATABASE_PASSWORD=

# Koneksi langsung ke Supabase (diutamakan oleh migrate.js). Bisa dikosongkan.
# Ambil dari Dashboard Supabase -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Daftar origin yang diizinkan untuk CORS, pisahkan dengan koma.
# Untuk produksi same-origin (frontend & API satu domain) bisa dikosongkan.
# Contoh lokal: http://127.0.0.1:5501
CORS_ORIGIN=http://127.0.0.1:5501

# === OPSIONAL: WhatsApp Gateway (di luar Vercel, butuh proses persistent) ===
# Set ke "true" hanya jika gateway WhatsApp sudah di-deploy terpisah.
WA_ENABLED=false
# WA_GATEWAY_URL=https://wa-gateway.example.com
